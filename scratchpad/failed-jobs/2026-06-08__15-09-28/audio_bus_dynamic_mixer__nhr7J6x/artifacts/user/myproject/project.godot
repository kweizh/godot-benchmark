config_version=5

[application]

config/name="AudioBusMixer"
config/features=PackedStringArray("4.3")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

AudioManager="*res://autoloads/AudioManager.gd"

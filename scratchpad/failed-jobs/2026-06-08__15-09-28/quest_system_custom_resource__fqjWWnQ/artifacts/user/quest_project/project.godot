; Engine configuration file.
;
; Initial project skeleton for the quest_system_custom_resource Harbor task.

config_version=5

[application]

config/name="quest_project"
config/features=PackedStringArray("4.3")

[autoload]

QuestManager="*res://autoloads/QuestManager.gd"

[script_classes]

script_classes=[{
"base": "Resource",
"class": "Quest",
"language": "GDScript",
"path": "res://scripts/Quest.gd"
}, {
"base": "Resource",
"class": "QuestObjective",
"language": "GDScript",
"path": "res://scripts/QuestObjective.gd"
}]

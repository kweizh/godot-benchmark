[ext_resource type="Script" path="res://scripts/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/QuestObjective.gd" id="1_obj"]

[sub_resource type="Resource" script_class="QuestObjective" id="obj_c1"]
script = ExtResource("1_obj")

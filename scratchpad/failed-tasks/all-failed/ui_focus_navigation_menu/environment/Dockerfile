FROM --platform=linux/amd64 ubuntu:24.04

RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl wget ca-certificates git python3 python3-pip python3-pytest bash ripgrep \
        unzip libfontconfig1 libfreetype6 libgl1 libxext6 libxrandr2 libxinerama1 libxcursor1 libxi6 libasound2t64 && \
    ln -s /usr/bin/python3 /usr/bin/python && \
    pip3 install --break-system-packages pytest-json-ctrf && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Godot 4.3 stable headless-capable binary
RUN wget -q https://github.com/godotengine/godot/releases/download/4.3-stable/Godot_v4.3-stable_linux.x86_64.zip -O /tmp/godot.zip && \
    unzip -q /tmp/godot.zip -d /tmp/ && \
    mv /tmp/Godot_v4.3-stable_linux.x86_64 /usr/local/bin/godot && \
    chmod +x /usr/local/bin/godot && \
    rm /tmp/godot.zip && \
    godot --headless --version

RUN mkdir -p /home/user && chmod 0755 /home/user

# Provide a minimal Godot 4 project skeleton at /home/user/myproject
RUN mkdir -p /home/user/myproject/scenes /home/user/myproject/autoloads && \
    cat >/home/user/myproject/project.godot <<'EOF'
; Engine configuration file.
; Generated by Harbor task bootstrap.

config_version=5

[application]

config/name="Focus Nav Menu"
config/features=PackedStringArray("4.3")
EOF

LABEL Author="generate-harbor-tasks"
LABEL Description="Godot 4.3 headless environment with a bare myproject skeleton for the ui_focus_navigation_menu task."

CMD ["/bin/bash", "-c", "trap : TERM INT; sleep infinity & wait"]

# Container contents:
#   - apt: curl wget ca-certificates git python3 python3-pip python3-pytest bash ripgrep unzip
#          plus runtime libs (libfontconfig1, libfreetype6, libgl1, libxext6, libxrandr2, libxinerama1,
#          libxcursor1, libxi6, libasound2t64) required by the Godot binary even in headless mode
#   - pip3: pytest-json-ctrf
#   - Godot 4.3-stable Linux x86_64 binary at /usr/local/bin/godot (verified with --version)
#   - /home/user/myproject: minimal Godot project skeleton (project.godot only)
